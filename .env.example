# Скопируй в .env и заполни. См. DEPLOY.md для процедуры первого запуска.

# Токен бота из @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# Username бота без @ (для реф-ссылок и текстов). По умолчанию: SystemAriseBot
BOT_USERNAME=SystemAriseBot

# Telegram user_id админов через запятую (доступ к /admin, /refund и т.п.)
ADMIN_IDS=

# Ключ Gemini API из Google AI Studio (обязательно для /report)
GEMINI_API_KEY=

# Основная и запасные модели Gemini — можно не переопределять, есть дефолты в config.py
# GEMINI_MODEL=gemini-3.1-flash-lite

# Часовой пояс для расчёта игрового "дня" и расписаний
BOT_TZ=Europe/Moscow

# Пути (в Docker переопределяются автоматически через volume /app/data — трогать не нужно)
# BOT_DATA_DIR=./data
# BOT_DB_PATH=./data/hunter.db
# BOT_BACKUP_DIR=./data/backups

# Бэкапы БД
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=28
